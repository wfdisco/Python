#Rock, Paper, Scissors game, compares your answer to random computer answer and gives the results.


import random

rock = '''
    _______
---'   ____)
      (_____)
      (_____)
      (____)
---.__(___)
'''

paper = '''
    _______
---'   ____)____
          ______)
          _______)
         _______)
---.__________)
'''

scissors = '''
    _______
---'   ____)____
          ______)
       __________)
      (____)
---.__(___)
'''

rock_paper_scissors = [rock,paper,scissors]

user_rps = int(input("What do you choose? Type 0 for Rock, 1 for Paper or 2 for Scissors\n"))
computer_choice = random.randint(0,2)
if user_rps >= 0 and user_rps <= 2:
    print(rock_paper_scissors[user_rps])
print(f"Computer Chose:\n")
print(rock_paper_scissors[computer_choice])

if user_rps >= 3 or user_rps < 0:
    print("Invalid number, You Lose")
elif user_rps == 0 and computer_choice == 2:
    print("You Win!")
elif computer_choice == 0 and user_rps == 2:
    print("You Lose!")
elif computer_choice > user_rps:
    print("You Lose!")
elif user_rps > computer_choice:
    print("You Win!")
elif computer_choice == user_rps:
    print("Draw Game!")
